#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/led/led.h>


/{
  behaviors{
    mt: custom_mod_tap {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        quick-tap-ms = <125>;
        bindings = <&kp>, <&kp>;
    };
  };
  macros{

  };
};

&pinctrl{
  spi3_default: spi3_default{
    group1{
      psels = <NRF_PSEL(SPIM_MOSI, 0, 17)>;
    };
  };

  spi3_sleep: spi3_sleep{
    group1 {
      psels = <NRF_PSEL(SPIM_MOSI, 0, 17)>;
    };
  };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: sk6812@0 {
        compatible = "worldsemi,ws2812-spi";
        label = "SK6812";

        reg = <0>; 
        spi-max-frequency = <4000000>;

        /* SK6812 Mini-E specific timing */
        chain-length = <35>; 
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

/ {
    chosen{
        zmk,underglow = &led_strip;
    };

    keymap {
        compatible = "zmk,keymap";

        /* --------------------- BASE LAYER --------------------- */
        base {
            bindings = <
                /* Row 0: Numbers across top */
                &kp ESC      &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp DEL   &kp EQUAL    &kp N6    &kp N7    &kp N8    &kp N9      &kp N0      &kp MINUS
                /* Row 1 */
                &kp GRAVE    &kp Q    &kp W    &kp E    &kp R    &kp T    &kp BSLH  &kp RBKT     &kp Y     &kp U     &kp I     &kp O       &kp P       &kp LBKT
                /* Row 2 */
                &mo 1        &kp A    &kp S    &kp D    &kp F    &kp G    &kp TAB   &kp TAB      &kp H     &kp J     &kp K     &kp L       &kp SEMI    &kp SQT
                /* Row 3 */
                &none        &kp Z    &kp X    &kp C    &kp V    &kp B    &kp CAPS  &none        &kp N     &kp M     &kp COMMA &kp DOT     &kp SLASH   &rgb_ug RGB_TOG
                /* Row 4 */
                &kp RCTRL    &kp RALT &kp LGUI &none  &none      &kp RSHFT &kp RET  &kp BSPC     &kp SPACE &mo 2     &kp RA(N1)&kp RA(N2)  &kp RA(N3)  &kp RA(N4)
            >;
        };

        /* --------------------- LAYER 1: Function / BT --------------------- */
        layer_1 {
            bindings = <
                /* Row 0 */
                &trans &kp F1          &kp F2          &kp F3          &kp F4       &kp F5       &kp F6     &kp F7   &kp F8     &kp F9       &kp F10       &kp F11      &kp F12      &trans
                /* Row 1 */
                &trans &out OUT_TOG    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR &trans   &kp C_MUTE &kp C_VOL_DN  &kp C_VOL_UP &kp C_PP     &kp C_FF     &trans
                /* Row 2 */
                &trans &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI &trans       &trans       &trans     &trans   &trans     &kp LEFT     &kp UP        &kp RIGHT    &kp DOWN     &trans
                /* Row 3 */
                &trans &rgb_ug RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_BRD &trans       &trans       &trans     &trans   &trans     &trans       &trans        &trans       &trans       &trans
                /* Row 4 */
                &trans &trans          &trans          &trans          &trans       &trans       &trans     &trans   &trans     &trans       &trans        &trans       &trans       &trans
            >;
        };

        layer_2 {
            bindings = <
                &trans &trans       &trans       &trans       &trans       &trans       &trans &trans   &trans     &trans       &trans       &trans       &trans       &trans
                &trans &trans       &trans       &trans       &trans       &trans       &trans &trans   &trans     &trans       &trans       &trans       &trans       &trans
                &trans &trans       &trans       &trans       &trans       &trans       &trans &trans   &trans     &trans       &trans       &trans       &trans       &trans
                &trans &trans       &trans       &trans       &trans       &trans       &trans &trans   &trans     &trans       &trans       &trans       &trans       &trans
                &trans &trans       &trans       &trans       &trans       &trans       &trans &trans   &trans     &trans       &trans       &trans       &trans       &trans
            >;
        };
    };
};
